+def verify_output_inventory(root, outputs, manifest_ref, expected_names):
+    """The supervisor seals 51 worker files, then appends its separate manifest."""
+    need(set(outputs) == expected_names, 'all 51 original output pins')
+    manifest_path = pin(manifest_ref)
+    need(manifest_path.resolve() == root / 'final-manifest.json', 'original output manifest path')
+    need({p.name for p in root.iterdir()} == expected_names | {'final-manifest.json'}, 'exact sealed original inventory')
+    expected_rows = []
+    for name, ref in sorted(outputs.items()):
+        path = pin(ref)
+        need(path.resolve() == root / name, 'output filename binding')
+        expected_rows.append(dict(path=name, bytes=ref['bytes'], sha256=ref['sha256']))
+    manifest = read_json(manifest_path)
+    need(set(manifest) == {'files'} and isinstance(manifest['files'], list), 'original manifest schema')
+    need(len(manifest['files']) == len(expected_rows), 'original manifest file count')
+    for row in manifest['files']:
+        need(set(row) == {'path', 'bytes', 'sha256'} and type(row['bytes']) is int, 'original manifest row schema')
+    need(manifest['files'] == expected_rows, 'original manifest path/bytes/hash inventory differs from output pins')
+    return sum(row['bytes'] for row in expected_rows)
+
